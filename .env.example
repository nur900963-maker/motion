# Rahasia JWT sesi (min 16 karakter, disarankan 32+). WAJIB.
# Buat: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-32chars
# Folder data JSON (opsional, hanya berlaku di luar Vercel). Default: ./data
# DATA_DIR=./data
# Batas unggah media dalam MB (di Vercel otomatis dibatasi maks 4 MB)
MAX_UPLOAD_MB=12
